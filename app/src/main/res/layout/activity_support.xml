<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2026 Support Hub"
                android:textColor="#00F2FE"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Support Icon"
                android:src="@drawable/ic_support" />
        </LinearLayout>

        <!-- AI Assistant Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_glass_3d"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Kitchen Assistant"
                android:textColor="#38EF7D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Need quick answers regarding recipe matching, ingredient expiry tracking, or unit conversion? Type your question below."
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/aiQueryInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/bg_card_glass_3d"
                    android:hint="Ask AI Chef..."
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/aiAskButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_gradient"
                    android:minHeight="48dp"
                    android:text="ASK AI"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_glass_3d"
                android:padding="12dp"
                android:textColor="#00F2FE"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Submit Ticket Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_glass_3d"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit Help Ticket"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/ticketCategorySpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_glass_3d"
                android:padding="8dp" />

            <EditText
                android:id="@+id/ticketSubjectInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints=""
                android:background="@drawable/bg_card_glass_3d"
                android:hint="Issue Subject"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF" />

            <EditText
                android:id="@+id/ticketMessageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints=""
                android:background="@drawable/bg_card_glass_3d"
                android:gravity="top"
                android:hint="Describe your inquiry or issue..."
                android:inputType="textMultiLine"
                android:lines="4"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF" />

            <Button
                android:id="@+id/submitTicketButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_gradient"
                android:minHeight="48dp"
                android:text="SUBMIT SUPPORT TICKET"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
