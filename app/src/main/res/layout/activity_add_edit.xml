<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textColor="#00F2FE"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_glass_3d"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:background="@drawable/bg_card_glass_3d"
                android:hint="Ingredient Name (e.g. Tomato)"
                android:inputType="textCapSentences"
                android:minHeight="50dp"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF" />

            <EditText
                android:id="@+id/quantityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:autofillHints=""
                android:background="@drawable/bg_card_glass_3d"
                android:hint="Quantity (e.g. 2)"
                android:inputType="numberDecimal"
                android:minHeight="50dp"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF" />

            <EditText
                android:id="@+id/unitInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:autofillHints=""
                android:background="@drawable/bg_card_glass_3d"
                android:hint="Unit (e.g. pieces, g, ml, tbsp)"
                android:inputType="text"
                android:minHeight="50dp"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF" />

            <EditText
                android:id="@+id/expiryInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:autofillHints=""
                android:background="@drawable/bg_card_glass_3d"
                android:hint="Expiry Date (YYYY-MM-DD)"
                android:inputType="date"
                android:minHeight="50dp"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_gradient"
                android:minHeight="52dp"
                android:text="SAVE TO PANTRY"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
