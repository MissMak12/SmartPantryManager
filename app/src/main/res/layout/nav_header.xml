<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@drawable/bg_gradient_main"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/navUserAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_card_glass_3d"
        android:padding="12dp"
        android:src="@drawable/ic_person" />

    <TextView
        android:id="@+id/navUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Smart Pantry User"
        android:textColor="#00F2FE"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="user@smartpantry.co.za"
        android:textColor="#B0BEC5"
        android:textSize="13sp" />

</LinearLayout>
